# =============================================================================
# Aitzaz AI — Environment configuration (template)
# Copy to `.env` and adjust. NEVER commit your real `.env`.
#   cp .env.example .env
# =============================================================================

# --- Core ----------------------------------------------------------------------
# "development" (relaxed) or "production" (strict secret checks)
AITZAZ_ENVIRONMENT=development
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AITZAZ_SECRET_KEY=change-me-in-production

# --- Database -------------------------------------------------------------------
# PostgreSQL (recommended). SQLite is supported for quick local tests.
AITZAZ_DATABASE_URL=postgresql+psycopg2://aitzaz:aitzaz@localhost:5432/aitzaz
# AITZAZ_DATABASE_URL=sqlite:///./aitzaz-dev.db
# Auto-create tables at startup (convenience for dev/tests; use Alembic in production)
AITZAZ_AUTO_CREATE_TABLES=false

# --- Redis (optional cache / jobs foundation) ------------------------------------
# Leave empty to run without Redis (built-in fallbacks are used).
AITZAZ_REDIS_URL=redis://localhost:6379/0

# --- LLM provider ----------------------------------------------------------------
# "mock" (built-in Demo AI, no API key needed) | "openai" | "anthropic"
AITZAZ_LLM_PROVIDER=mock
AITZAZ_OPENAI_API_KEY=
AITZAZ_OPENAI_MODEL=gpt-4o-mini
AITZAZ_ANTHROPIC_API_KEY=
AITZAZ_ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Simulated latency for the Demo AI (milliseconds)
AITZAZ_MOCK_LLM_DELAY_MS=250

# --- Auth / cookies ----------------------------------------------------------------
AITZAZ_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AITZAZ_COOKIE_NAME=aitzaz_session
# Set true when serving over HTTPS
AITZAZ_COOKIE_SECURE=false
AITZAZ_COOKIE_SAMESITE=lax

# --- CORS ----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (frontend URL)
AITZAZ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting (foundation) --------------------------------------------------------
AITZAZ_RATE_LIMIT_ENABLED=true
AITZAZ_RATE_LIMIT_PER_MINUTE=240

# --- Agent runtime ---------------------------------------------------------------------
AITZAZ_DEFAULT_TIMEZONE=UTC

# --- Seed data (development only — documented demo credentials) --------------------------
AITZAZ_DEMO_USER_EMAIL=demo@aitzaz.ai
AITZAZ_DEMO_USER_NAME=Demo User
AITZAZ_DEMO_USER_PASSWORD=demo-user-2026
# Create the demo account on `seed` even outside development
AITZAZ_SEED_DEMO_USER=true

# --- Frontend (apps/web) ------------------------------------------------------------------
# Origin of the FastAPI backend used by the Next.js proxy/rewrites
BACKEND_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=Aitzaz AI
