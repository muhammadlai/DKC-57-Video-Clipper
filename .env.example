# DKC 57 Video Clipper — root environment (used by docker-compose)
# Copy to .env and adjust. Placeholders only — never commit real keys.

# Frontend URL the backend may serve (CORS)
CORS_ORIGIN=http://localhost:5000

# Maximum video upload size in MB (default 10240 = 10 GB)
MAX_UPLOAD_MB=10240

# Optional: enable API-key auth on the backend (REST + WebSocket).
# When set, the frontend image is built with the same key and sends it
# automatically. Leave empty for open local access.
D57_API_KEY=

# Only relevant if you enable the optional Ollama service
# (docker compose --profile ollama up -d ollama)
OLLAMA_HOST=http://ollama:11434

# Only change if your browser reaches the backend at a different address
NEXT_PUBLIC_API_URL=http://localhost:8000
