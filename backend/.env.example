# DKC 57 Video Clipper — Backend Configuration
# Copy this file to .env and fill in your values.
# NEVER commit real API keys — .env is git-ignored.

# Directory for temporary video/clip files
TMP_DIR=./tmp

# SQLite database path
DB_PATH=./data/openclip.db

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5000

# Maximum upload size in MB (default 10240 = 10 GB)
MAX_UPLOAD_MB=10240

# ============================================
# FFmpeg (DKC 57)
# ============================================
# Resolution order: FFMPEG_PATH / FFPROBE_PATH env vars → system PATH →
# bundled binary in backend/bin.  Leave unset to use the system FFmpeg.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ============================================
# Optional API-key authentication (DKC 57)
# ============================================
# When set, all /api/* requests must send this key (X-API-Key header or
# Authorization: Bearer).  Leave unset for open local access.
# D57_API_KEY=change-me

# ============================================
# LLM (AI moment detection)
# ============================================
# Providers are configured in the app Settings page (stored encrypted in
# SQLite, never returned by the API).  For Ollama (local AI) point at a
# local server — no paid service required.
# OLLAMA_HOST=http://localhost:11434

# ============================================
# IMPORTANT: Never commit real API keys!
# Add your keys to .env (not .env.example)
# ============================================
